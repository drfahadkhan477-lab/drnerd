  "above": {
    "function color-mix": {
      "since": "16.2",
      "class": "fallback",
      "how": "companion",
      "probe": "color:color-mix(in srgb,red,blue)",
      "sim": "color-mix",
      "note": "Each rule that uses it is followed by an @supports not rule that spells it with a theme token (the same ground in the same theme, without the tint or the glow). A plain value written before it would not do: a declaration with a var() in it is judged when the page is drawn, and comes to nothing there."
    },
    "function sin": {
      "since": "15.4",
      "class": "progressive",
      "note": "The resting pose of the voice-wave bars, which shows only while their animation is off (Reduce Motion): without it the bars stand at full height."
    },
    "layout flex-gap": {
      "since": "14.5",
      "class": "accepted",
      "note": "gap on a flex box is not read before the version in this row (on a grid it already is). The items of a row close up: a chip against its icon, a button against the next. Measured on Chromium with gap: 0 put on every flex box: every screen changes, and the three looked at (home, study, a question answered) lose nothing. Not fixed: it would need a runtime shim for every gap in the stylesheets, since whether a rule's box is a flex box is the cascade's to say and not the text's."
    },
    "property aspect-ratio": {
      "since": "15",
      "class": "fallback",
      "how": "companion",
      "probe": "aspect-ratio:1",
      "sets": [
        "height",
        "padding-bottom"
      ],
      "sim": "aspect-ratio",
      "exempt": {
        ".echo-teaching-image": "An img: where aspect-ratio is not read it is shown at its own proportions, without the black bars of its box."
      },
      "narrower": {
        ".heat-cell": {
          "by": ".heat .heat-cell",
          "why": "The legend's swatches are .heat-cell too, inside .heat-key, and are sized by their width and height (.heat-key i); only the cells of the grid (.heat) are sized by the ratio, so only they are given a box made the old way."
        }
      },
      "note": "A box that has only a ratio is 0 px tall where it is not read: the heat map and the two diagram stages. Each is followed by an @supports not rule that makes the same box with a height of 0 and a padding-bottom that is a share of the width (under min() with the max-height, which clamps the height), the max-width that a max-height gives a ratio box, and the canvas laid over it."
    },
    "property contain": {
      "since": "15.4",
      "class": "accepted",
      "note": "The pearl card on the tablet home grid (app/css/tablet.css, which says so): where contain: size is not read the card sizes its row from its text, and a long pearl scrolls the page and not the card."
    },
    "property inset": {
      "since": "14.5",
      "class": "banned",
      "note": "Written as top, right, bottom and left: a box that is positioned by inset alone is not positioned at all where it is not read."
    },
    "property overscroll-behavior": {
      "since": "16",
      "class": "progressive",
      "note": "A panel's scroll goes on to the page behind it when it reaches its end."
    },
    "property padding-block": {
      "since": "14.5",
      "class": "banned",
      "note": "Written as padding-top and padding-bottom."
    },
    "property resize": {
      "since": null,
      "class": "inert",
      "note": "iPadOS shows no resize handle, so the property has nothing to do there."
    },
    "property scroll-behavior": {
      "since": "15.4",
      "class": "progressive",
      "note": "The page jumps to an anchor or a scrollTo where it would glide."
    },
    "property scrollbar-width": {
      "since": "18.2",
      "class": "progressive",
      "note": "iPadOS draws scroll indicators over the content, and only while it scrolls: a strip that scrolls sideways shows its indicator for that moment."
    },
    "property text-wrap": {
      "since": "17.4",
      "class": "progressive",
      "note": "Lines break by the ordinary rule."
    },
    "property translate": {
      "since": "14.5",
      "class": "fallback",
      "how": "guard",
      "probe": "translate:0 1px",
      "sim": "translate",
      "guard": ".scroll-reveal",
      "note": "The scroll-reveal offset: an @supports not rule shows the item at once where translate is not read, and not at opacity 0 waiting for a slide it cannot make."
    },
    "selector ::view-transition-new": {
      "since": "18",
      "class": "progressive",
      "note": "Screens change without the cross-fade."
    },
    "selector ::view-transition-old": {
      "since": "18",
      "class": "progressive",
      "note": "As ::view-transition-new."
    },
    "selector :focus-visible": {
      "since": "15.4",
      "class": "fallback",
      "how": "split",
      "note": "A rule with an unknown pseudo-class in its list is dropped whole, the selectors that were known with it, so no list holds it with one that does not need it. Where every selector of a list needs it, what is lost is the keyboard focus ring, and the engine's own is drawn."
    },
    "selector :has": {
      "since": "15.4",
      "class": "fallback",
      "how": "split",
      "note": "As :focus-visible. The one rule that holds it alone is a refinement, and the pair that keeps a unit's menu above the cards below it is two rules."
    },
    "unit dvh": {
      "since": "15.4",
      "class": "fallback",
      "how": "elsewhere",
      "where": "tests/verify-ipad-pure.js",
      "note": "Every declaration that uses it has the same value in vh before it, which that suite holds."
    },
    "value align-content: start": {
      "since": "15.6",
      "class": "fallback",
      "how": "before",
      "sim": "align-content-start",
      "note": "flex-start is written before it, which a grid reads as start."
    },
    "value contain: layout": {
      "since": "15.4",
      "class": "progressive",
      "note": "PhotoSwipe's .pswp (app/css/photoswipe.css): containment is a rendering hint there, and without it an older Safari lays the viewer out the same and does more work to paint it."
    },
    "value contain: size": {
      "since": "15.4",
      "class": "accepted",
      "note": "As property contain."
    },
    "value contain: style": {
      "since": "15.4",
      "class": "progressive",
      "note": "As value contain: layout."
    },
    "value overflow-wrap: anywhere": {
      "since": "15.4",
      "class": "fallback",
      "how": "before",
      "sim": "overflow-wrap-anywhere",
      "note": "break-word is written before it."
    },
    "value overscroll-behavior: contain": {
      "since": "16",
      "class": "progressive",
      "note": "As property overscroll-behavior."
    },
    "value scroll-behavior: auto": {
      "since": "15.4",
      "class": "progressive",
      "note": "As property scroll-behavior."
    },
    "value scroll-behavior: smooth": {
      "since": "15.4",
      "class": "progressive",
      "note": "As property scroll-behavior."
    },
    "value scrollbar-width: none": {
      "since": "18.2",
      "class": "progressive",
      "note": "As property scrollbar-width."
    },
    "value text-wrap: pretty": {
      "since": "26",
      "class": "progressive",
      "note": "As property text-wrap."
    },
    "value translate: none": {
      "since": "14.5",
      "class": "fallback",
      "how": "guard",
      "probe": "translate:0 1px",
      "sim": "translate",
      "guard": ".scroll-reveal",
      "note": "As property translate."
    }
  },
