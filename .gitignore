# Xcode, CocoaPods and Firebase rules lived here from a template this project
# never used — it is Node scripts, plain HTML and a Cloudflare Worker, and
# nothing matching them has ever been tracked. Removed rather than left to
# suggest a shape the repository does not have.

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
# Licensed question-bank content — never commit these.
# Your ACCSAP export and anything derived from it stays on your own devices.
content/
*ACCSAP*.html
*.accsap.json

# Stage 1 build output — contains a copy of the licensed content.
dist/

# Local build output — contains a copy of the licensed content.
build/
source/

# Python bytecode from tools/
__pycache__/
*.pyc

# Transcript of the last failing verify run — quotes licensed suite output.
tests/last-run.log

# Knowledge graphs written by `graphify` — graph.json, GRAPH_REPORT.md,
# graph.html. Pointed at this repository it indexes source/, build/, content/
# and dist/, so the graph carries excerpts of the licensed question text under
# a name that suggests nothing of the kind. leak-guard refuses this prefix too;
# a .gitignore entry is a default, and only the guard is a boundary.
graphify-out/

# Local artifacts from running the suite by hand. None of these belongs in the
# repository and two of them are builds, so they carry the licensed corpus —
# leak-guard rule 3 refuses anything over 1 MB, but only once `npm run hooks`
# has been run on that clone, and a laptop that has never run it is exactly
# where these accumulate.
*.zip
*.log
figdiag.js
verify-fails.log

# Installed packages — ts-fsrs is a dev-time oracle for verify-oracle,
# regenerated by hand with tools/gen-fsrs-oracle.js. Nothing here ships.
node_modules/
